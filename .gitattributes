# 统一换行符：源码入库用 LF，Windows 脚本检出为 CRLF
* text=auto eol=lf

*.py    text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
*.txt   text eol=lf
*.json  text eol=lf
*.yml   text eol=lf

*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# 二进制文件不做行尾转换
*.png   binary
*.jpg   binary
*.ico   binary
*.exe   binary
*.bin   binary
*.zip   binary
